{
  "realm": "gastroshift",
  "displayName": "GastroShift",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "MANAGER",
        "description": "Full access to the GastroShift management API",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "EMPLOYEE",
        "description": "Access to GastroShift employee self-service endpoints",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "gastroshift-swagger",
      "name": "GastroShift Swagger UI",
      "description": "Public client for local Swagger UI authentication",
      "rootUrl": "http://localhost:8081",
      "adminUrl": "http://localhost:8081",
      "baseUrl": "http://localhost:8081/swagger-ui/index.html",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:8081/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "standard.token.exchange.enabled": "false",
        "oauth2.jwt.authorization.grant.enabled": "false",
        "post.logout.redirect.uris": "http://localhost:8081/swagger-ui/index.html",
        "oauth2.device.authorization.grant.enabled": "false",
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.revoke.offline.tokens": "false",
        "dpop.bound.access.tokens": "false"
      },
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "organization",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "id": "10000000-0000-0000-0000-000000000001",
      "username": "manager-demo",
      "enabled": true,
      "email": "manager.demo@example.com",
      "emailVerified": false,
      "firstName": "Manager",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_MANAGER_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "MANAGER"
      ]
    },
    {
      "id": "10000000-0000-0000-0000-000000000002",
      "username": "employee-demo",
      "enabled": true,
      "email": "employee.demo@example.com",
      "emailVerified": false,
      "firstName": "Employee",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_EMPLOYEE_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "EMPLOYEE"
      ]
    }
  ]
}